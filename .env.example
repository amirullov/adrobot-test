APP_ENV=development
DATABASE_URL=postgresql+psycopg://adrobot:adrobot@db:5432/adrobot

# fake runs the full local demo without a Keitaro account; http uses Admin API.
KEITARO_MODE=fake
KEITARO_BASE_URL=https://tracker.example.com
KEITARO_API_KEY=replace-me
KEITARO_DOMAIN_ID=1
KEITARO_GROUP_ID=1
KEITARO_TRAFFIC_SOURCE_ID=1
KEITARO_GOOGLE_URL=https://www.google.com/
KEITARO_ADMIN_CAMPAIGN_URL_TEMPLATE={base_url}/admin/#!/campaigns/{campaign_id}
KEITARO_TIMEOUT_SECONDS=10
KEITARO_GET_RETRIES=2

# Compatibility boundary: verify these against the target tracker's Swagger/UI.
KEITARO_COUNTRY_FILTER_NAME=country
KEITARO_REDIRECT_ACTION_TYPE=http
KEITARO_OFFER_ACTION_TYPE=offer
